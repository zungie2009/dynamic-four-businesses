{
  "container": {
    "defaultUser": "robert",
    "accessMode": "DEMONSTRATION_USER_SWITCHER",
    "accessWarning": "The selector intentionally permits switching among all four demo identities; replace it with authenticated server-resolved identity for production.",
    "productionAuthentication": false
  },
  "uiNeuron": {
    "fieldTypeControlMap": {
      "REFERENCE": "SAME_PARTITION_ENTITY_PICKER",
      "STRING": "TEXT_INPUT",
      "ENUM": "LOCALIZED_SELECT",
      "INTEGER": "INTEGER_INPUT",
      "ISO_DATE": "DATE_INPUT",
      "EMAIL": "EMAIL_INPUT",
      "DECIMAL_19_2": "DECIMAL_INPUT"
    },
    "enumDisplay": "BUSINESS_LOCALE_LABEL",
    "enumStorage": "CANONICAL_UPPERCASE_VALUE",
    "projectionRule": "REPLACE_NOT_MERGE",
    "unrestrictedStatusEditing": false
  },
  "administration": {
    "surfaceRequired": true,
    "surfaceType": "STANDALONE_NAVIGATION_VIEW",
    "route": "/administration",
    "navigationPosition": "BOTTOM_LEFT",
    "visibleForEveryDemoUser": true,
    "userAware": true,
    "stateOwnership": "ACTIVE_BUSINESS_SELF",
    "scope": "OWN_BUSINESS_ONLY",
    "persistence": "SURVIVES_PROCESS_RESTART",
    "reprojectOnUserChange": true,
    "projectionRule": "REPLACE_NOT_MERGE",
    "fields": [
      {
        "persisted": true,
        "labelKey": "BUSINESS_DISPLAY_NAME",
        "control": "TEXT_INPUT",
        "required": true,
        "editable": true,
        "id": "businessName"
      },
      {
        "persisted": true,
        "labelKey": "THEME",
        "control": "ALLOWED_THEME_SELECT",
        "required": true,
        "editable": true,
        "id": "theme"
      },
      {
        "persisted": true,
        "labelKey": "NOTIFICATIONS",
        "control": "LOCALIZED_ENABLED_DISABLED_SELECT",
        "required": true,
        "editable": true,
        "id": "notifications"
      },
      {
        "persisted": false,
        "labelKey": "LANGUAGE_LOCALE",
        "control": "READ_ONLY_TEXT",
        "source": "ACTIVE_BUSINESS_SELF",
        "editable": false,
        "id": "locale"
      },
      {
        "persisted": true,
        "labelKey": "SCHEMA_VERSION",
        "control": "READ_ONLY_TEXT",
        "source": "ACTIVE_BUSINESS_PARTITION",
        "editable": false,
        "id": "schemaVersion"
      },
      {
        "persisted": false,
        "labelKey": "PERSISTENCE_PARTITION",
        "control": "READ_ONLY_TEXT",
        "source": "SERVER_RESOLVED_CONTEXT",
        "editable": false,
        "id": "persistencePartition"
      }
    ],
    "actions": [
      {
        "validation": "REQUIRED_FIELDS_AND_ALLOWED_VALUES",
        "control": "PRIMARY_BUTTON",
        "auditEvents": [
          "THEME_CHANGED",
          "ADMINISTRATION_CHANGED"
        ],
        "writes": "ACTIVE_BUSINESS_PARTITION_ONLY",
        "id": "SAVE_ADMINISTRATION"
      }
    ],
    "accessWarningRequired": true,
    "accessWarningSource": "containerSelf.accessWarning",
    "labelsLocalizedByActiveBusiness": true,
    "auditResponsibility": "NONE_USE_AUDIT_NEURON",
    "acceptanceScenarios": [
      "Administration appears as a bottom-left navigation item for every demo user.",
      "Opening Administration renders every declared field and action; omission of the view or a required control is a build failure.",
      "Switching users while Administration is open reconstructs the Administration view for the newly active business without merging state.",
      "Saved business name, theme and notification preference survive a complete process restart and remain isolated from every other business.",
      "Locale, schema version and persistence partition are visible but cannot be edited.",
      "Every saved administrative mutation emits the declared partition-scoped audit event.",
      "The view visibly states that the demo selector is not production authentication."
    ]
  },
  "auditNeuron": {
    "scope": "SHARED_CAPABILITY_WITH_BUSINESS_PARTITION_CONTEXT",
    "eventFields": [
      "timestamp",
      "userId",
      "businessAppId",
      "entityId",
      "operation",
      "target"
    ],
    "administrationProducesAudit": false,
    "events": [
      "SEED_RECORD_CREATED",
      "RECORD_CREATED",
      "RECORD_DELETED",
      "STATE_TRANSITION",
      "THEME_CHANGED",
      "ADMINISTRATION_CHANGED",
      "DEMO_SEED_COMPLETED"
    ],
    "rule": "The business operation or persistence boundary emits audit events; Administration does not own auditing.",
    "ordinaryReadsAudited": false
  },
